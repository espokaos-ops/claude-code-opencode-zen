# Copiar a gateway.env y rellenar los valores. Este archivo NO se versiona.
# Upstream: mock | passthrough | zen | nvidia
CLAUDE_GATEWAY_UPSTREAM=nvidia
CLAUDE_GATEWAY_PORT=8479
# NVIDIA NIM (OpenAI-compatible). NVIDIA_API_KEY es obligatoria para upstream nvidia.
# Nunca pegues aqui una clave real si el archivo fuera a commitearse: se ignora via .gitignore.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
